# 复制为 .env 后填写

# 对外访问地址（不带结尾斜杠）
PUBLIC_URL=https://llm.example.com

# ---- AnythingLLM 密钥 ----
# 生成：openssl rand -hex 32
JWT_SECRET=
SIG_KEY=
SIG_SALT=

# ---- Authelia OIDC ----
# Authelia 的根地址（issuer），不带路径
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=anythingllm
# 填 authelia crypto hash generate 输出的 "Random Password"（明文），
# Authelia 配置里填的是对应的 "Digest"
OIDC_CLIENT_SECRET=

# ---- 登录桥 ----
# 用于签名登录过程中的临时 cookie。生成：openssl rand -hex 32
BRIDGE_SECRET=
# 第一阶段在 AnythingLLM「设置 → 开发者 API」中创建后填入
ANYTHINGLLM_API_KEY=

# ---- 权限映射（Authelia 组名，多个用逗号分隔）----
# 只允许这些组的用户登录；留空表示所有通过 Authelia 认证的用户都可登录
ALLOWED_GROUPS=anythingllm
# 映射为 AnythingLLM admin / manager 的组；其余用户为 default
ADMIN_GROUPS=admins
MANAGER_GROUPS=
# 每次登录按上面的组同步角色（true/false）。
# 只在配置了 ADMIN_GROUPS 或 MANAGER_GROUPS 时生效；开启后在 UI 中手动改的角色会被覆盖。
SYNC_ROLE=true

# 新用户首次登录时自动加入的工作区（工作区 slug，逗号分隔）
DEFAULT_WORKSPACES=
# 按组授权工作区：组:slug1|slug2,组2:slug3   每次登录追加，不会自动移除
GROUP_WORKSPACES=
